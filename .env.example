# === AI Protocol: "openai_compatible" or "claude" ===
# openai_compatible = Chat Completions protocol (/v1/chat/completions, /v1/models)
# claude = Messages protocol (/v1/messages, /v1/models)
AI_BACKEND=openai_compatible

# === Chat Completions protocol ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Use the UI "获取模型" button to populate and select this value.
OPENAI_MODEL=

# === Messages protocol ===
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Use the UI "获取模型" button to populate and select this value.
SUMMARIZE_MODEL=

# === Legacy provider preset fields (kept for backward compatibility) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# === Image Generation (文生图) ===
# 开启后，@机器人 且消息带生图意图关键词（如“画一张”“生图”）时，
# 调用图片模型生成图片并发送到群聊。
IMAGE_GEN_ENABLED=false
# openai_images = OpenAI Images 兼容协议（OpenAI/New API/One API 等）
# google_gemini_image = Google Gemini Interactions 图片协议
# dashscope_qwen = 阿里云百炼 Qwen-Image 原生协议
IMAGE_GEN_PROTOCOL=openai_images
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
# Use the UI 生图模型配置 "获取模型" button to populate and select this value.
IMAGE_GEN_MODEL=
# 可选图片尺寸（如 1024x1024 / 1024x1792 / 1792x1024）；留空由模型默认
IMAGE_GEN_SIZE=
# 生图意图关键词（逗号分隔）；命中任一关键词即触发生图
IMAGE_GEN_KEYWORDS=画一张,画一个,画一幅,画一只,画个,帮我画,生成一张,生成一幅,生成图片,生图,来一张图,画出来

# === WeChat 数据目录（可选，留空则自动检测）===
# 如果微信聊天记录不在默认路径（Documents\xwechat_files 或 Documents\WeChat Files），
# 请在此填写包含 wxid_* 文件夹的父目录绝对路径。
# 例如: D:\WeChatData 或 C:\Users\xxx\AppData\Roaming\Tencent\WeChat
WECHAT_DATA_DIR=

# === webot 自身数据目录（可选，留空则使用程序目录下的 data）===
# 仅存储 webot 自己生成的数据：messages.db、bot.log、昵称、欢迎模板、群缓存等。
# 不影响 WECHAT_DATA_DIR，也不会移动微信自己的聊天记录。
# 例如: D:\WebotData
WEBOT_DATA_DIR=

# === WeChat Backend ===
# Windows: wcdb. macOS: mac_hybrid (WeFlow WCDB read + Accessibility send) or mac_ui fallback.
WECHAT_BACKEND=wcdb
# Optional: override the detected macOS WeChat account data directory.
MAC_WEFLOW_DATA_DIR=
# macOS WeChat send shortcut: enter or cmd_enter.
MAC_WECHAT_SEND_SHORTCUT=enter
# Comma-separated group names. "*" = auto-discover all groups.
WECHAT_GROUPS=
# Comma-separated friend names (or wxid) to auto-chat with in 1-on-1 chats.
# Empty = no friend is auto-replied. "*" = all discovered friends.
# Prefer selecting friends in the web UI — only checked friends get AI replies.
WECHAT_FRIENDS=

# === AI Chat Switches ===
# Master switch for @bot conversations in group chats. When false, the bot
# ignores group chat messages (summaries, image generation and todos still work).
GROUP_CHAT_ENABLED=true
# Master switch for 1-on-1 AI replies. When false, selected friends get no reply.
FRIEND_CHAT_ENABLED=true

# === Bot Identity ===
# Your bot's WeChat display name. Used for @mention detection.
BOT_DISPLAY_NAME=群聊小助手

# === Trigger Keywords ===
# Comma-separated. The bot also responds to @mentions regardless of keywords.
TRIGGER_KEYWORDS=总结一下,之前发了什么,错过了什么,summarize,what did i miss,聊天总结,帮我总结,前面说了什么,说了啥,发生了什么

# === Database ===
# 留空或保持 data/messages.db 时，会跟随 WEBOT_DATA_DIR。
# 只有需要单独覆盖 SQLite 文件位置时才改这里。
DB_PATH=data/messages.db

# === Features ===

# 趣味功能 — @机器人抽签，返回随机运势签文（true/false）
FUN_ENABLED=true

# === MCP Server（把微信数据暴露给 Codex / Trae 等外部智能体）===
# 开关（默认开启）。关闭后 /mcp 与 /mcp/sse 均返回 403。
MCP_ENABLED=true
# 请求密钥。留空时可在 Web 控制台「MCP 服务」面板一键生成；
# 泄露后可在面板点「轮换密钥」立即生成新的随机密钥（旧密钥马上失效）。
# 客户端需携带 Authorization: Bearer <key> 或 X-API-Key: <key>。
MCP_API_KEY=
# 允许访问 MCP 的主机名，逗号分隔（默认仅 127.0.0.1 / localhost / ::1）。
# 使用隧道或反向代理时把域名加进来，例如：MCP_ALLOWED_HOSTS=xxx.trycloudflare.com
MCP_ALLOWED_HOSTS=
# 数据范围：智能体可读取哪些群聊 / 好友的聊天内容。
# 留空或 * = 全部（默认）；none = 不允许任何会话；也可填逗号分隔的 ID 列表，
# 例如 MCP_GROUPS=123@chatroom,456@chatroom / MCP_FRIENDS=wxid_abc,wxid_def。
# 推荐直接在 Web 控制台「MCP 服务 → 数据范围」里按好友/群聊 Tab 勾选保存。
MCP_GROUPS=
MCP_FRIENDS=
# 消息类工具的数据源。默认 auto：优先读微信本地完整历史，不可用时回退
# messages.db；设为 messages 可强制只用机器人采集库（不打开微信本地库）。
MCP_HISTORY_SOURCE=auto

# === Feishu Knowledge Base ===
# 开启后，@机器人说“同步到飞书”等触发词会自动创建/维护一个多维表格知识库。
FEISHU_EXPORT_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EXPORT_MODE=knowledge
FEISHU_EXPORT_WINDOW_HOURS=8
FEISHU_EXPORT_TRIGGER_KEYWORDS=同步到飞书,导出到飞书,写到飞书,沉淀到飞书
# 开启后，最近窗口消息数达到阈值时会无感自动沉淀，不回群消息。
FEISHU_AUTO_SYNC_ENABLED=false
FEISHU_AUTO_SYNC_MIN_MESSAGES=20
FEISHU_AUTO_SYNC_COOLDOWN_SEC=1800
FEISHU_KNOWLEDGE_BASE_NAME=webot 群聊沉淀
# 可选：指定飞书文件夹 token；留空则使用应用默认创建位置。
FEISHU_KNOWLEDGE_FOLDER_TOKEN=

# === Tuning ===
# Seconds between message polls (default: 1.0, increase for lower CPU usage)
POLL_INTERVAL_SEC=1.0
# Minimum seconds between trigger responses in the same chat (dedup)
DEDUP_WINDOW_SEC=60
# Max messages to include in summary prompt.
# For groups with 999+ messages, increase this value.
# The bot uses token estimation + automatic chunking (map-reduce) to handle
# very large conversations safely within the model's context window.
MAX_MESSAGES_FOR_SUMMARY=5000
# Messages per chunk when map-reduce is triggered (default: 400)
CHUNK_SIZE=400
# If requester has no prior message, or the detected window is too small,
# expand to this many hours (minimum summary window)
FALLBACK_WINDOW_HOURS=8

# === Welcome New Member ===
# Master switch — automatically send a welcome message when a new
# member joins a group chat. Templates and per-group settings are
# stored in the configured webot data directory.
WELCOME_ENABLED=false

# === Proactive Participation ===
# Master switch — enable autonomous chat participation without @mention
PROACTIVE_ENABLED=false
# Rate calculation window in seconds (default: 120 = 2 minutes)
PROACTIVE_RATE_WINDOW_SEC=120
# Message rate thresholds (msgs/min) for each mode.
# Calibrate by running: python tools/analyze_chat_rhythm.py
PROACTIVE_RATE_QUIET=1.5
PROACTIVE_RATE_CASUAL=4.0
PROACTIVE_RATE_LIVELY=6.5
PROACTIVE_RATE_BURST=8.5

# === Sticky Mention ===
# When a user sends @bot with no message text, the bot enters sticky
# listening mode.  The user's next message in the same group is treated
# as if it were @mentioned (one-shot — consumed on first non-empty follow-up).
# Set to false to disable entirely.
STICKY_MENTION_ENABLED=true
# Max seconds to wait for the follow-up message after an empty @mention
STICKY_MENTION_TTL_SEC=60

# === Logging ===
LOG_LEVEL=INFO
# Optional log file. data/bot.log follows WEBOT_DATA_DIR.
LOG_FILE=data/bot.log

# === Onboarding ===
# Draft/progress state is stored in SQLite onboarding_state.
# ONBOARDING_DONE remains in .env for startup compatibility.
ONBOARDING_DONE=false
WCDB_KEY=
